# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Must match the Go backend's JWT_SECRET: we validate its access tokens.
JWT_SECRET=

# In Docker (bookly network): http://api:8080 and redis://redis:6379/1
# Local dev against dockerized infra: http://127.0.0.1:8080 and redis://127.0.0.1:6379/1
BOOKLY_API_URL=http://api:8080
REDIS_URL=redis://redis:6379/1

DEBUG=false
